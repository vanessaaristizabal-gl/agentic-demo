# Clave de la API de Anthropic usada UNICAMENTE por el servidor (apps/api)
# para el boton «Redactar con IA» de la etapa `vacante`.
#
# Copia este archivo a `.env` en la raiz del repositorio y pon tu clave real.
# El archivo `.env` esta en .gitignore y nunca debe commitearse.
#
# Si esta variable no existe, o la llamada al modelo falla, el servidor
# devuelve un texto de reserva determinista y la aplicacion sigue
# funcionando con normalidad.
ANTHROPIC_API_KEY=

# Modelo usado por el servidor. Por defecto: claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# Puerto del servidor de API. Por defecto: 3001
API_PORT=3001
